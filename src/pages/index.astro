---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import CrossOfferBanner from '../components/CrossOfferBanner.astro';
import Hero from '../components/Hero.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ProblemFit from '../components/ops/ProblemFit.astro';
import Offer from '../components/ops/Offer.astro';
import AI from '../components/ops/AI.astro';
import About from '../components/startups/About.astro';
import FAQ from '../components/FAQ.astro';
import { OPS_FAQS, OPS_PROCESS_STEPS } from '../data/content';
import Contact from '../components/ops/Contact.astro';
import Footer from '../components/Footer.astro';

const stripHtml = (value: string) => value.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
const pageUrl = 'https://beemflow.com/';
const pageTitle = 'BeemFlow | Make AI Actually Run Your Operations, Not Just Your Board Deck';
const pageDescription =
  'We map your operations, surface the highest-ROI automation opportunities, and show a realistic path to freeing 40+ hours/month of people-as-glue work, with clear math back to FTE and EBITDA.';

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  url: pageUrl,
  description: pageDescription,
  inLanguage: 'en-US',
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'BeemFlow',
  url: pageUrl,
  description: pageDescription,
  serviceType: 'Process automation platform and managed deployment',
  areaServed: 'Global',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: OPS_FAQS.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: stripHtml(faq.a),
    },
  })),
};

const schemas = [webPageSchema, serviceSchema, faqSchema];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage="/og-image-ops.png"
  ogImageAlt="BeemFlow process and AI operations service overview"
  schemas={schemas}
>
  <Nav />
  <!-- Hidden for now
  <CrossOfferBanner
    lead="Building a funded software or AI product?"
    body="We also run market-ready v1 sprints for founders who need product, engineering, and design leadership."
    linkHref="/startups/"
    linkText="See Startup V1 Sprints"
    ariaLabel="Startup offer"
  />
  -->
  <main id="main-content">
    <Hero
      eyebrow="Process &amp; AI Ops"
      body="We map your operations, surface the highest&#8209;ROI automation opportunities, and show a realistic path to freeing 40+&nbsp;hours/month of &lsquo;people&#8209;as&#8209;glue&rsquo; work in a single function, with clear math back to FTE and&nbsp;EBITDA."
      ctaHref="#ops-final-cta"
      ctaText="Check if the Blueprint is a fit"
      secondaryHref="#ops-process"
      secondaryText="See how it works"
      id="ops-hero"
    >
      Make AI actually run your&nbsp;operations,<br />
      <span class="hero__accent text-accent">not just your board&nbsp;deck.</span>
    </Hero>
    <ProblemFit />
    <Offer />
    <ProcessSteps
      id="ops-process"
      label="The Process"
      heading="How it works"
      ariaLabel="How the process works"
      items={OPS_PROCESS_STEPS}
    />
    <AI />
    <About class="bg-base" />
    <FAQ items={OPS_FAQS} heading="Questions you should be asking" id="ops-faq" class="bg-elevated" />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
