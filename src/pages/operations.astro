---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import CrossOfferBanner from '../components/CrossOfferBanner.astro';
import Hero from '../components/Hero.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ProblemFit from '../components/ops/ProblemFit.astro';
import Offer from '../components/ops/Offer.astro';
import AI from '../components/ops/AI.astro';
import FAQ from '../components/FAQ.astro';
import { OPS_FAQS, OPS_PROCESS_STEPS } from '../data/content';
import Contact from '../components/ops/Contact.astro';
import Footer from '../components/Footer.astro';

const stripHtml = (value: string) => value.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
const pageUrl = 'https://beemflow.com/operations/';
const pageTitle = 'BeemFlow | Make AI Actually Run Your Operations, Not Just Your Board Deck';
const pageDescription =
  'For PE-backed and multi-location service businesses ($3M-$50M). We ship a production-ready workflow in 2 weeks and a plan to reclaim 10+ hours/month of manual work. Workflow assessment, implementation sprints, and ongoing stewardship.';

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  url: pageUrl,
  description: pageDescription,
  inLanguage: 'en-US',
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'BeemFlow',
  url: pageUrl,
  description: pageDescription,
  serviceType: 'Workflow and AI operations automation',
  areaServed: 'Global',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: OPS_FAQS.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: stripHtml(faq.a),
    },
  })),
};

const schemas = [webPageSchema, serviceSchema, faqSchema];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage="/og-image-ops.png"
  ogImageAlt="BeemFlow workflow and AI operations service overview"
  schemas={schemas}
>
  <Nav />
  <CrossOfferBanner
    lead="Building a funded software or AI product?"
    body="We also run market-ready v1 sprints for founders who need product, engineering, and design leadership."
    linkHref="/"
    linkText="See Startup V1 Sprints"
    ariaLabel="Startup offer"
  />
  <main id="main-content">
    <Hero
      eyebrow="Workflow &amp; AI Ops"
      body="For PE&#8209;backed and multi&#8209;location service businesses ($3M&#8211;$50M) held together by &ldquo;people&nbsp;as&nbsp;glue.&rdquo;<br/><br/>We ship a production&#8209;ready workflow in 2&nbsp;weeks and a plan to reclaim 10+&nbsp;hours/month of manual work.<br/><br/>If we don&rsquo;t deliver, we build an extra workflow at our&nbsp;cost."
      ctaHref="#ops-final-cta"
      ctaText="Check if the Assessment is a fit"
      secondaryHref="#ops-process"
      secondaryText="See how it works"
      id="ops-hero"
    >
      Make AI actually run your&nbsp;operations,<br />
      <span class="hero__accent text-accent">not just your board&nbsp;deck.</span>
    </Hero>
    <ProblemFit />
    <Offer />
    <ProcessSteps
      id="ops-process"
      label="The Assessment"
      heading="How it works"
      ariaLabel="How the assessment works"
      items={OPS_PROCESS_STEPS}
    />
    <AI />
    <FAQ items={OPS_FAQS} heading="Questions you should be asking" id="ops-faq" />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
