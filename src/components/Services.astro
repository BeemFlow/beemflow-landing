---
import { STEPS, SERVICES } from '../data/content';
import SectionHeader from './SectionHeader.astro';
---

<section class="section how">
  <div class="container">
    <SectionHeader label="How we work">Blueprint. Build. Launch.</SectionHeader>

    <!-- Three-Step Journey -->
    <div class="how__steps">
      {STEPS.map((step, i) => (
        <div class="how__step" data-fade data-fade-delay={String(i * 0.08)}>
          <div class="how__step-number">{step.number}</div>
          <div class="how__step-content">
            <div class="how__step-header">
              <h3 class="how__step-title">{step.title}{step.subtitle && <span class="how__step-subtitle"> ({step.subtitle})</span>}</h3>
              <div class="how__step-meta">
                <span class="text-mono-sm how__step-price">{step.price}</span>
                <span class="text-mono-sm how__step-timeline">{step.timeline}</span>
              </div>
            </div>
            <p class="text-body how__step-desc">{step.description}</p>
            {step.deliverables && (
              <ul class="how__step-deliverables">
                {step.deliverables.map((d) => (
                  <li class="text-body how__step-deliverable">{d}</li>
                ))}
              </ul>
            )}
            {step.endState && (
              <p class="text-body how__step-endstate">{step.endState}</p>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- BeemSpec Callout — prominent section -->
    <div class="how__beemspec" data-fade data-fade-delay="0.25">
      <h3 class="how__beemspec-title">Why we ship faster: BeemSpec, our AI coordination system</h3>
      <p class="text-body how__beemspec-intro">
        Most teams bolt AI onto a traditional process. We rebuilt the process around AI from day one.
      </p>
      <p class="text-body how__beemspec-text">
        BeemSpec is our AI&#8209;native planning and coordination layer:
      </p>
      <ul class="how__beemspec-list">
        <li class="text-body">Story maps become structured, executable specs</li>
        <li class="text-body">AI coding agents pull exactly the context they need, when they need it</li>
        <li class="text-body">No manual copy&#8209;paste between planning tools and implementation</li>
      </ul>
      <p class="text-body how__beemspec-closer">
        We don't sell BeemSpec to you as a separate product (yet). We use it on every
        engagement so two founder&#8209;engineers can reliably deliver like a much larger team.
      </p>
    </div>

    <!-- Service Offerings -->
    <div class="how__services-label" data-fade data-fade-delay="0.3">
      <p class="label-mono text-accent">What we offer</p>
    </div>
    <div class="how__services">
      {SERVICES.map((s, i) => (
        <div class="how__service" data-fade data-fade-delay={String(0.28 + i * 0.06)}>
          <div class="how__service-header">
            <span class="how__service-icon">{s.icon}</span>
            <span class="how__service-label">{s.label}</span>
          </div>
          <h4 class="how__service-title">{s.title}</h4>
          <p class="text-body how__service-desc">{s.description}</p>
        </div>
      ))}
    </div>

    <!-- Equity hybrid removed from public site.
         Internal lever only: propose 2-5% equity on top of normal fees
         when YOU want the upside, not when the client asks for a discount.
         Reintroduce on-site after 10+ paying cash clients. -->
  </div>
</section>

<style>
  .how {
    background: var(--color-bg-subtle);
  }

  /* Three-Step Journey */
  .how__steps {
    display: grid;
    gap: 1px;
    background: var(--color-border-subtle);
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 64px;
  }

  .how__step {
    background: var(--color-bg-elevated);
    padding: 40px 36px;
    display: flex;
    gap: 32px;
    align-items: flex-start;
  }

  .how__step-number {
    font-family: var(--font-mono);
    font-size: 32px;
    font-weight: 600;
    color: var(--color-accent);
    line-height: 1;
    flex-shrink: 0;
    opacity: 0.4;
  }

  .how__step-content {
    flex: 1;
  }

  .how__step-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
  }

  .how__step-title {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .how__step-meta {
    display: flex;
    gap: 16px;
    align-items: baseline;
  }

  .how__step-price {
    color: var(--color-accent);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .how__step-timeline {
    color: var(--color-text-faint);
    letter-spacing: 0.02em;
  }

  .how__step-subtitle {
    font-weight: 400;
    font-size: 16px;
    color: var(--color-text-faint);
  }

  .how__step-desc {
    color: var(--color-text-dim);
    max-width: 640px;
  }

  .how__step-deliverables {
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
  }

  .how__step-deliverable {
    color: var(--color-text-dim);
    padding-left: 16px;
    position: relative;
    margin-bottom: 6px;
    font-size: 14px;
    line-height: 1.6;
  }

  .how__step-deliverable::before {
    content: "\2013";
    position: absolute;
    left: 0;
    color: var(--color-accent);
    opacity: 0.5;
  }

  .how__step-endstate {
    color: var(--color-text-muted);
    margin-top: 12px;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.6;
  }

  /* Service Offerings Grid */
  .how__services-label {
    margin-bottom: 24px;
  }

  .how__services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 32px;
    margin-bottom: 48px;
  }

  .how__service {
    padding: 24px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    transition: border-color 0.3s ease;
  }

  .how__service:hover {
    border-color: var(--color-accent-hover);
  }

  .how__service-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .how__service-icon {
    font-size: 20px;
    line-height: 1;
  }

  .how__service-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent);
    opacity: 0.7;
  }

  .how__service-title {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 8px;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .how__service-desc {
    color: var(--color-text-dim);
    font-size: 14px;
    line-height: 1.6;
  }

  /* BeemSpec Callout */
  .how__beemspec {
    margin-bottom: 64px;
    padding: 36px;
    border: 1px solid var(--color-border-accent);
    border-radius: 8px;
    background: var(--color-bg-elevated);
  }

  .how__beemspec-title {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 16px;
    color: var(--color-text);
  }

  .how__beemspec-intro {
    color: var(--color-text-muted);
    margin-bottom: 16px;
    font-weight: 500;
  }

  .how__beemspec-text {
    color: var(--color-text-dim);
    margin-bottom: 12px;
  }

  .how__beemspec-list {
    list-style: none;
    padding: 0;
    margin: 0 0 16px;
  }

  .how__beemspec-list li {
    color: var(--color-text-dim);
    padding-left: 16px;
    position: relative;
    margin-bottom: 6px;
    font-size: 14px;
    line-height: 1.6;
  }

  .how__beemspec-list li::before {
    content: "\2013";
    position: absolute;
    left: 0;
    color: var(--color-accent);
    opacity: 0.5;
  }

  .how__beemspec-closer {
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* Equity Hybrid */
  .how__equity {
    padding: 32px 36px;
    border: 1px solid var(--color-border-accent);
    border-radius: 8px;
  }

  .how__equity-header {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .how__equity-label {
    font-size: 13px;
    font-weight: 600;
  }

  .how__equity-qualifier {
    color: var(--color-text-faint);
    font-size: 12px;
  }

  .how__equity-text {
    color: var(--color-text-dim);
    line-height: 1.6;
    margin-bottom: 8px;
  }

  .how__equity-list {
    list-style: none;
    padding: 0;
    margin: 0 0 16px;
  }

  .how__equity-list li {
    color: var(--color-text-dim);
    padding-left: 16px;
    position: relative;
    margin-bottom: 4px;
    font-size: 14px;
    line-height: 1.6;
  }

  .how__equity-list li::before {
    content: "\2013";
    position: absolute;
    left: 0;
    color: var(--color-accent);
    opacity: 0.5;
  }

  .how__equity-closer {
    color: var(--color-text-muted);
    font-weight: 500;
    font-style: italic;
    margin-top: 8px;
  }

  @media (max-width: 600px) {
    .how__step {
      flex-direction: column;
      gap: 16px;
    }

    .how__step-number {
      font-size: 24px;
    }
  }
</style>
