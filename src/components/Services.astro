---
import { STEPS, SERVICES } from '../data/content';
import SectionHeader from './SectionHeader.astro';
---

<section class="section how">
  <div class="container">
    <SectionHeader label="How we work">Blueprint. Build. Launch.</SectionHeader>

    <p class="how__squad text-body" data-fade data-fade-delay="0.05">
      For each build, we assemble a small senior squad: both founders, a product
      designer we trust, and (when needed) infra / security specialists we've
      worked with before. You don't get handed to layers of juniors. We stay
      your single point of accountability.
    </p>

    <!-- Three-Step Journey -->
    <div class="how__steps">
      {STEPS.map((step, i) => (
        <div class="how__step" data-fade data-fade-delay={String(i * 0.08)}>
          <div class="how__step-number">{step.number}</div>
          <div class="how__step-content">
            <div class="how__step-header">
              <h3 class="how__step-title">{step.title}{step.subtitle && <span class="how__step-subtitle"> ({step.subtitle})</span>}</h3>
              <div class="how__step-meta">
                <span class="text-mono-sm how__step-price">{step.price}</span>
                <span class="text-mono-sm how__step-timeline">{step.timeline}</span>
              </div>
            </div>
            <p class="text-body how__step-desc">{step.description}</p>
            {step.deliverables && (
              <ul class="how__step-deliverables">
                {step.deliverables.map((d) => (
                  <li class="text-body how__step-deliverable">{d}</li>
                ))}
              </ul>
            )}
            {step.endState && (
              <p class="text-body how__step-endstate">{step.endState}</p>
            )}
            {step.guarantee && (
              <p class="how__step-guarantee">{step.guarantee}</p>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- BeemSpec Callout -->
    <div class="how__beemspec" data-fade data-fade-delay="0.25">
      <h3 class="how__beemspec-title">Why we ship faster: BeemSpec, our AI coordination system</h3>
      <p class="text-body how__beemspec-intro">
        Most teams bolt AI onto a traditional process. We rebuilt the process around AI from day one.
      </p>
      <p class="text-body how__beemspec-text">
        BeemSpec is our AI&#8209;native planning and coordination layer:
      </p>
      <ul class="how__beemspec-list">
        <li class="text-body">Story maps become structured, executable specs</li>
        <li class="text-body">AI coding agents pull exactly the context they need, when they need it</li>
        <li class="text-body">No manual copy&#8209;paste between planning tools and implementation</li>
      </ul>
      <p class="text-body how__beemspec-closer">
        We don't sell BeemSpec to you as a separate product (yet). We use it on every
        engagement so two founder&#8209;engineers can reliably deliver like a much larger team.
      </p>
    </div>

    <!-- Service Offerings -->
    <div class="how__services-label" data-fade data-fade-delay="0.3">
      <p class="label-mono text-accent">What we offer</p>
    </div>
    <div class="how__services">
      {SERVICES.map((s, i) => (
        <div class="how__service" data-fade data-fade-delay={String(0.28 + i * 0.06)}>
          <div class="how__service-header">
            <span class="how__service-icon">{s.icon}</span>
            <span class="how__service-label">{s.label}</span>
          </div>
          <h4 class="how__service-title">{s.title}</h4>
          <p class="text-body how__service-desc">{s.description}</p>
        </div>
      ))}
    </div>

    <div class="how__cta" data-fade data-fade-delay="0.35">
      <a href="#contact" class="btn-primary">Book a 30-minute fit call &rarr;</a>
    </div>

    <!-- Equity hybrid removed from public site.
         Internal lever only: propose 2-5% equity on top of normal fees
         when YOU want the upside, not when the client asks for a discount.
         Reintroduce on-site after 10+ paying cash clients. -->
  </div>
</section>

<style>
  .how {
    background: var(--color-bg-elevated);
  }

  .how__squad {
    color: var(--color-text-muted);
    max-width: 600px;
    margin-bottom: 48px;
  }

  /* ── Three-Step Journey ── */
  .how__steps {
    display: flex;
    flex-direction: column;
    margin-bottom: 80px;
  }

  .how__step {
    padding: 48px 0;
    display: flex;
    gap: 40px;
    align-items: flex-start;
    border-top: 1px solid var(--color-border);
  }

  .how__step:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .how__step-number {
    font-family: var(--font-display);
    font-size: 64px;
    font-weight: 300;
    color: var(--color-text-faint);
    line-height: 0.85;
    flex-shrink: 0;
    min-width: 80px;
    letter-spacing: -0.04em;
  }

  .how__step-content {
    flex: 1;
  }

  .how__step-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 16px;
  }

  .how__step-title {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .how__step-meta {
    display: flex;
    gap: 16px;
    align-items: baseline;
  }

  .how__step-price {
    color: var(--color-accent);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .how__step-timeline {
    color: var(--color-text-dim);
    letter-spacing: 0.02em;
  }

  .how__step-subtitle {
    font-weight: 400;
    font-size: 16px;
    color: var(--color-text-dim);
    font-family: var(--font-sans);
  }

  .how__step-desc {
    color: var(--color-text-muted);
    max-width: 640px;
  }

  .how__step-deliverables {
    list-style: none;
    padding: 0;
    margin: 16px 0 0;
  }

  .how__step-deliverable {
    color: var(--color-text-muted);
    padding-left: 20px;
    position: relative;
    margin-bottom: 8px;
    font-size: 15px;
    line-height: 1.6;
  }

  .how__step-deliverable::before {
    content: "\2013";
    position: absolute;
    left: 0;
    color: var(--color-accent);
    opacity: 0.6;
  }

  .how__step-endstate {
    color: var(--color-text);
    margin-top: 16px;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.6;
  }

  .how__step-guarantee {
    margin-top: 16px;
    padding: 14px 18px;
    border: 1px solid var(--color-border-accent);
    background: var(--color-accent-soft);
    font-family: var(--font-display);
    font-size: 15px;
    font-style: italic;
    color: var(--color-text);
    line-height: 1.5;
    max-width: 600px;
  }

  .how__step-guarantee::before {
    content: "Milestone overrun protection: ";
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
    display: block;
    margin-bottom: 6px;
  }

  /* ── BeemSpec Callout ── */
  .how__beemspec {
    margin-bottom: 80px;
    padding: 40px;
    border-left: 3px solid var(--color-accent);
    background: var(--color-accent-soft);
  }

  .how__beemspec-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: 16px;
    color: var(--color-text);
  }

  .how__beemspec-intro {
    color: var(--color-text-muted);
    margin-bottom: 16px;
    font-weight: 500;
  }

  .how__beemspec-text {
    color: var(--color-text-muted);
    margin-bottom: 12px;
  }

  .how__beemspec-list {
    list-style: none;
    padding: 0;
    margin: 0 0 16px;
  }

  .how__beemspec-list li {
    color: var(--color-text-muted);
    padding-left: 20px;
    position: relative;
    margin-bottom: 8px;
    font-size: 15px;
    line-height: 1.6;
  }

  .how__beemspec-list li::before {
    content: "\2013";
    position: absolute;
    left: 0;
    color: var(--color-accent);
    opacity: 0.6;
  }

  .how__beemspec-closer {
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* ── Service Offerings Grid ── */
  .how__services-label {
    margin-bottom: 24px;
  }

  .how__services {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    margin-bottom: 48px;
  }

  .how__service {
    padding: 32px;
    background: var(--color-bg-elevated);
    transition: background 0.3s ease;
  }

  .how__service:hover {
    background: var(--color-accent-soft);
  }

  .how__service-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .how__service-icon {
    font-size: 18px;
    line-height: 1;
  }

  .how__service-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .how__service-title {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 500;
    margin-bottom: 10px;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .how__service-desc {
    color: var(--color-text-muted);
    font-size: 15px;
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .how__step {
      flex-direction: column;
      gap: 16px;
      padding: 36px 0;
    }

    .how__step-number {
      font-size: 48px;
    }

    .how__services {
      grid-template-columns: 1fr;
    }
  }

  .how__cta {
    text-align: center;
    padding-top: 16px;
  }
</style>
