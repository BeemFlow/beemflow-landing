---
import FadeIn from './FadeIn.astro';

interface Props {
  eyebrow: string;
  body: string;
  ctaHref: string;
  ctaText: string;
  secondaryHref: string;
  secondaryText: string;
  id?: string;
}

const { eyebrow, body, ctaHref, ctaText, secondaryHref, secondaryText, id } = Astro.props;
---

<section class="hero" id={id} aria-label="Introduction">
  <div class="container">
    <FadeIn delay={0.1}>
      <p class="hero__eyebrow label-mono">{eyebrow}</p>
      <h1 class="hero__heading">
        <slot />
      </h1>
    </FadeIn>
    <FadeIn delay={0.2}>
      <p class="hero__body" set:html={body} />
    </FadeIn>
    <FadeIn delay={0.3}>
      <div class="hero__actions">
        <a href={ctaHref} class="btn-primary">{ctaText} &rarr;</a>
        <a href={secondaryHref} class="hero__link">{secondaryText} &darr;</a>
      </div>
    </FadeIn>
  </div>
</section>

<script>
  const updateHeroViewport = () => {
    const heroes = document.querySelectorAll<HTMLElement>('.hero');
    heroes.forEach((hero) => {
      const top = hero.getBoundingClientRect().top;
      hero.style.setProperty('--hero-top-offset', `${Math.max(0, Math.round(top))}px`);
    });
  };

  requestAnimationFrame(updateHeroViewport);
  window.addEventListener('resize', updateHeroViewport);
</script>

<style>
  .hero {
    min-height: calc(100svh - var(--hero-top-offset, 0px));
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 104px 32px 100px;
    position: relative;
  }

  .hero > .container {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .hero__eyebrow {
    margin-bottom: var(--space-md);
    color: var(--color-text-muted);
  }

  .hero__heading {
    font-size: clamp(36px, 6.5vw, 72px);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.03em;
    margin-bottom: 32px;
    max-width: 900px;
  }

  .hero__body {
    font-size: var(--fs-body-xl);
    line-height: 1.7;
    max-width: 560px;
    margin-bottom: var(--space-md);
  }

  .hero__actions {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    align-items: center;
  }

  .hero__link {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding: 15px 0;
    transition: color var(--motion-hover) var(--ease-standard);
    position: relative;
  }

  .hero__link::after {
    content: '';
    position: absolute;
    bottom: 12px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-text);
    transition: width var(--motion-hover) var(--ease-standard);
  }

  .hero__link:hover {
    color: var(--color-text);
  }

  .hero__link:hover::after {
    width: 100%;
  }

  /* Heading accent variants (used via slots) */
  .hero__heading :global(.hero__timeline),
  .hero__heading :global(.hero__accent) {
    display: block;
    margin-top: 4px;
    font-size: clamp(22px, 4vw, 46px);
    font-style: italic;
  }

  .hero__heading :global(.hero__timeline s) {
    text-decoration: line-through;
    text-decoration-thickness: 2px;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .hero {
      padding: 84px 20px 60px;
      min-height: calc(100svh - var(--hero-top-offset, 0px));
    }
  }
</style>
