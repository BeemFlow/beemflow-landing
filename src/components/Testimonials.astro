---
import { TESTIMONIALS } from '../data/content';

const publishedTestimonials = TESTIMONIALS.filter(
  (testimonial) => !testimonial.quote.includes('[TODO')
);
---

<!--
  YC: "A one-line testimonial from a Travel Money founder or a HyperPlay
  investor would be worth more than every stat on this page combined."

  This section renders once you fill in the [TODO] quotes in content.ts.
  It's hidden if all quotes still contain [TODO].
-->

{publishedTestimonials.length > 0 && (
  <section class="section testimonials">
    <div class="container--narrow">
      <div class="testimonials__grid">
        {publishedTestimonials.map((t, i) => (
          <blockquote class="testimonial" data-fade data-fade-delay={String(i * 0.1)}>
            <p class="testimonial__quote">&ldquo;{t.quote}&rdquo;</p>
            <footer class="testimonial__attribution">
              <span class="testimonial__name">{t.name}</span>
              <span class="testimonial__role">{t.role}, {t.company}</span>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .testimonials {
    padding: 100px 32px;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .testimonials__grid {
    display: grid;
    gap: 56px;
  }

  .testimonial {
    padding-left: 28px;
    border-left: 2px solid var(--color-accent);
  }

  .testimonial__quote {
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.6;
    color: var(--color-text);
    font-weight: 400;
    font-style: italic;
    margin-bottom: 20px;
  }

  .testimonial__attribution {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .testimonial__name {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .testimonial__role {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-dim);
    letter-spacing: 0.02em;
  }
</style>
