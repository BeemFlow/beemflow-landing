---
import { PROOF_CLIENTS, PROOF_STATS } from '../data/content';
---

<section class="proof" data-fade>
  <div class="container proof__inner">
    <div class="proof__stats">
      {PROOF_STATS.map((s) => (
        <div class="proof__stat">
          <span class="proof__stat-num">{s.num}</span>
          <span class="proof__stat-label">{s.label}</span>
        </div>
      ))}
    </div>
    <div class="proof__divider"></div>
    <div class="proof__clients">
      <span class="label-mono proof__label">Built for</span>
      {PROOF_CLIENTS.map((name) => (
        <span class="proof__client">{name}</span>
      ))}
    </div>
  </div>
</section>

<style>
  .proof {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 48px 32px;
  }

  .proof__inner {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .proof__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    text-align: center;
    padding-bottom: 32px;
  }

  .proof__divider {
    width: 100%;
    height: 1px;
    background: var(--color-border-subtle);
  }

  .proof__stat {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .proof__stat-num {
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 400;
    color: var(--color-text);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .proof__stat-label {
    font-size: 13px;
    color: var(--color-text-dim);
    letter-spacing: 0.01em;
  }

  .proof__clients {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    justify-content: center;
    padding-top: 28px;
  }

  .proof__label {
    color: var(--color-text-dim);
  }

  .proof__client {
    font-size: 14px;
    color: var(--color-text-muted);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  @media (max-width: 500px) {
    .proof__stats {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
