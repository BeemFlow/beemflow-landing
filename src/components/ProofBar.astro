---
import { PROOF_CLIENTS, PROOF_STATS } from '../data/content';
---

<section class="proof" data-fade>
  <div class="container proof__inner">
    <p class="proof__inline label-mono">
      {PROOF_STATS.map((s, i) => (
        <span>{s.num ? `${s.num} ` : ''}{s.label}{i < PROOF_STATS.length - 1 ? <span class="proof__sep"> &middot; </span> : ''}</span>
      ))}
    </p>
    <p class="proof__protection label-mono">Milestone overrun protection included</p>
    <div class="proof__divider"></div>
    <div class="proof__clients">
      <span class="label-mono proof__label">Built for</span>
      {PROOF_CLIENTS.map((name) => (
        <span class="proof__client">{name}</span>
      ))}
    </div>
  </div>
</section>

<style>
  .proof {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 48px 32px;
  }

  .proof__inner {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .proof__inline {
    color: var(--color-text-muted);
    text-align: center;
    padding-bottom: 8px;
    line-height: 2;
  }

  .proof__sep {
    color: var(--color-text-faint);
    margin: 0 4px;
  }

  .proof__protection {
    color: var(--color-accent);
    text-align: center;
    padding-bottom: 28px;
    opacity: 0.8;
  }

  .proof__divider {
    width: 100%;
    height: 1px;
    background: var(--color-border-subtle);
  }

  .proof__clients {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    justify-content: center;
    padding-top: 28px;
  }

  .proof__label {
    color: var(--color-text-dim);
  }

  .proof__client {
    font-size: 14px;
    color: var(--color-text-muted);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  @media (max-width: 500px) {
    .proof__inline {
      text-align: left;
    }
  }
</style>
