---
import { CREDENTIALS } from '../../data/content';
import SectionHeader from '../SectionHeader.astro';
import FadeIn from '../FadeIn.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section class:list={["section", "about", className]} aria-label="About us">
  <div class="container--narrow">
    <SectionHeader label="Who we are" compact>
      Built by operators, for operators
    </SectionHeader>
    <FadeIn delay={0.1}>
      <p class="text-body-lg about__text">
        BeemFlow was founded by Alec Wantoch and Zach Pelkey, two engineer&#8209;founders who
        previously co&#8209;founded Valist (acquired by HyperPlay), led product and security through
        HyperPlay's Series A and first 100K+ downloads, and shipped 15+ production systems across
        fintech, infrastructure, and education.
      </p>
      <p class="text-body-lg about__text">
        That experience is now embedded in two product assets:
        <a href="https://beemspec.com" target="_blank" rel="noopener noreferrer">BeemSpec</a>,
        our AI&#8209;native story mapping and coordination platform that scopes and specs every build,
        and the <strong>workflow template library</strong> that powers every BeemFlow deployment. The platform is supported
        by a senior team spanning product design, infrastructure, and security engineering:
        the same people we've shipped multiple products with.
      </p>
    </FadeIn>
    <FadeIn delay={0.15}>
      <p class="text-body-lg about__text">
        Every deployment is planned through <a href="https://beemspec.com" target="_blank" rel="noopener noreferrer">BeemSpec</a>
        and built on reusable workflow templates, so a small senior team can consistently deliver
        enterprise&#8209;grade automation at startup speed.
      </p>
    </FadeIn>
    <FadeIn delay={0.2}>
      <div class="about__credentials">
        {CREDENTIALS.map((cred) =>
          cred.href ? (
            <a class="about__credential about__credential--link" href={cred.href} target="_blank" rel="noopener noreferrer">{cred.label}</a>
          ) : (
            <span class="about__credential">{cred.label}</span>
          )
        )}
      </div>
    </FadeIn>
    <FadeIn delay={0.25}>
      <p class="text-body-lg about__closer">
        Whether we are shipping your first product or pulling humans out of manual glue work, the goal is the same: build the right thing, build it fast, and build it on foundations you own so you can keep moving without&nbsp;us.
      </p>
    </FadeIn>
  </div>
</section>

<style>
  .about.bg-base {
    --about-credential-bg: var(--color-bg-elevated);
  }

  .about.bg-elevated {
    --about-credential-bg: var(--color-bg);
  }

  .about__subtitle {
    color: var(--color-text-muted);
    margin-bottom: 28px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .about__text {
    margin-bottom: var(--space-md);
    max-width: var(--max-width-narrow);
  }

  .about__credentials {
    margin-top: var(--space-md);
    margin-bottom: 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    max-width: var(--max-width-narrow);
  }

  .about__credential {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.03em;
    background: var(--about-credential-bg, var(--color-bg));
    padding: 7px 14px;
    border-radius: 2px;
    border: 1px solid var(--color-border);
  }

  .about__credential--link {
    transition:
      border-color var(--motion-hover) var(--ease-standard),
      color var(--motion-hover) var(--ease-standard);
  }

  .about__credential--link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .about__closer {
    color: var(--color-text);
    max-width: var(--max-width-narrow);
    font-weight: 500;
  }
</style>
