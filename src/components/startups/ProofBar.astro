---
import { PROOF_STATS } from '../../data/content';
import ClientsBar from '../ClientsBar.astro';
import FadeIn from '../FadeIn.astro';
---

<FadeIn>
  <section class="proof" aria-label="Credentials">
    <div class="container proof__inner">
      <p class="proof__inline label-mono">
        {PROOF_STATS.map((s, i) => (
          <span>{s.num ? `${s.num} ` : ''}{s.label}{i < PROOF_STATS.length - 1 ? <span class="proof__sep"> &middot; </span> : ''}</span>
        ))}
      </p>
      <p class="proof__protection label-mono">Milestone overrun protection: if we miss your agreed v1 launch by &gt;2&nbsp;weeks for reasons in our control, we eat the&nbsp;overage.</p>
      <ClientsBar />
    </div>
  </section>
</FadeIn>

<style>
  .proof {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-lg) 32px;
    text-align: center;
  }

  .proof__inner {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .proof__inline {
    padding-bottom: var(--space-xs);
    line-height: 2;
  }

  .proof__sep {
    color: var(--color-text-faint);
    margin: 0 4px;
  }

  .proof__protection {
    color: var(--color-accent);
    padding-bottom: 28px;
  }

  @media (max-width: 500px) {
    .proof {
      padding: 32px 20px;
    }
  }
</style>
