---
import { STEPS, SERVICES } from '../../data/content';
import SectionHeader from '../SectionHeader.astro';
import FadeIn from '../FadeIn.astro';
import OfferSteps from '../OfferSteps.astro';
---

<section class="section how" aria-label="How we work">
  <div class="container">
    <SectionHeader label="How we work">Blueprint. Build. Launch.</SectionHeader>

    <FadeIn delay={0.05}>
      <div class="how__squad">
        <p class="text-body">
          For each build, we assemble a small senior squad: <strong>both founders</strong>, a product
          designer we trust, and (when needed) infra / security specialists we've
          worked with before.
          <br/>
          You don't get handed to layers of juniors. We stay
          your <strong>single point of&nbsp;accountability</strong>.
        </p>
        <p class="text-body">
          When scope demands more hands, we add engineers inside that squad&nbsp;–
          they plug into our <a href="https://beemspec.com" target="_blank" rel="noopener noreferrer">BeemSpec</a> system, our standards, and our review, so you
          still have one accountable brain trust instead of a revolving door
          of&nbsp;contractors.
        </p>
      </div>
    </FadeIn>

    <OfferSteps steps={STEPS} />

    <!-- BeemSpec Callout -->
    <FadeIn delay={0.25}>
      <div class="how__beemspec">
        <h3 class="how__beemspec-title">Why we ship faster</h3>
        <p class="text-body how__beemspec-intro">
          <a href="https://beemspec.com" target="_blank" rel="noopener noreferrer">BeemSpec</a> is our AI&#8209;native product management and coordination system.
          We map your whole product in one place: users, flows, specs, releases,
          designs, and architecture, so every human and every agent is working from
          the same source of&nbsp;truth.
        </p>
        <p class="text-body how__beemspec-intro">
          AI coding agents then operate inside that structure, handling the
          repetitive work while we stay on top of product decisions, architecture,
          security, and code review. We supervise the agents, review their output
          as we go, and keep the system&nbsp;clean.
        </p>
        <p class="text-body how__beemspec-closer">
          You get the speed of agents with the judgment of two founder&#8209;engineers:
          faster execution, solid architecture, and higher&#8209;quality code guided by
          years of shipping real products to&nbsp;production.
        </p>
      </div>
    </FadeIn>

    <!-- Service Offerings -->
    <FadeIn delay={0.3}>
      <div class="how__services-label">
        <p class="label-mono text-accent">What we offer</p>
      </div>
      <div class="how__services">
        {SERVICES.map((s) => (
          <div class="how__service">
            <div class="how__service-header">
              <span class="how__service-icon" aria-hidden="true">{s.icon}</span>
              <span class="how__service-label">{s.label}</span>
            </div>
            <h4 class="how__service-title">{s.title}</h4>
            <p class="text-body how__service-desc" set:html={s.description} />
          </div>
        ))}
      </div>

      <div class="how__cta">
        <a href="#contact" class="btn-primary">Book a 30-minute fit call &rarr;</a>
      </div>
    </FadeIn>

    <!-- Equity hybrid removed from public site.
         Internal lever only: propose 2-5% equity on top of normal fees
         when YOU want the upside, not when the client asks for a discount.
         Reintroduce on-site after 10+ paying cash clients. -->
  </div>
</section>

<style>
  .how {
    background: var(--color-bg-elevated);
  }

  .how__squad {
    max-width: var(--content-measure);
    margin-bottom: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  /* ── BeemSpec Callout ── */
  .how__beemspec {
    margin-bottom: var(--space-xl);
    padding: 40px;
    border-left: 3px solid var(--color-accent);
    background: var(--color-accent-soft);
  }

  .how__beemspec-title {
    font-size: var(--fs-title);
    letter-spacing: -0.01em;
    margin-bottom: var(--space-sm);
    color: var(--color-text);
  }

  .how__beemspec-intro {
    margin-bottom: var(--space-sm);
    font-weight: 500;
  }

  .how__beemspec-closer {
    font-style: italic;
  }

  /* ── Service Offerings Grid ── */
  .how__services-label {
    margin-bottom: 24px;
  }

  .how__services {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    margin-bottom: var(--space-lg);
  }

  .how__service {
    padding: 32px;
    background: var(--color-bg-elevated);
    transition: background var(--motion-hover) var(--ease-standard);
  }

  .how__service:hover {
    background: var(--color-accent-soft);
  }

  .how__service-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .how__service-icon {
    font-size: var(--fs-body-xl);
    line-height: 1;
  }

  .how__service-label {
    font-family: var(--font-mono);
    font-size: var(--fs-label-sm);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .how__service-title {
    font-size: var(--fs-body-xl);
    margin-bottom: 10px;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .how__service-desc {
    font-size: var(--fs-body-sm);
  }

  @media (max-width: 640px) {
    .how__services {
      grid-template-columns: 1fr;
    }
  }

  .how__cta {
    text-align: center;
    padding-top: 16px;
  }
</style>
