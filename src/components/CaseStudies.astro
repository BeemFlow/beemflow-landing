---
import { CASE_STUDIES } from '../data/content';
import SectionHeader from './SectionHeader.astro';
import FadeIn from './FadeIn.astro';
---

<section class="section cases" id="work" aria-label="Case studies">
  <div class="container">
    <SectionHeader label="Track record">What we've built</SectionHeader>
    <div class="cases__grid">
      {CASE_STUDIES.map((c, i) => (
        <FadeIn delay={i * 0.08}>
          <div class="cases__card">
            <div class="cases__card-header">
              <h3 class="cases__headline">{c.headline}</h3>
              <span class="text-mono-sm cases__role">{c.role}</span>
            </div>
            <p class="cases__result-summary">{c.resultSummary}</p>
            <div class="cases__body">
              <p class="text-body cases__situation">{c.situation}</p>
              <p class="text-body cases__result">{c.result}</p>
              <div class="cases__metrics">
                {c.metrics.map((m) => (
                  <span class="cases__metric">{m}</span>
                ))}
              </div>
            </div>
          </div>
        </FadeIn>
      ))}
    </div>
    <FadeIn delay={0.3}>
      <div class="cases__cta">
        <a href="#contact" class="btn-primary">See if your v1 fits our sprint model &rarr;</a>
      </div>
    </FadeIn>
  </div>
</section>

<style>
  .cases__grid {
    display: grid;
    gap: 0;
  }

  .cases__card {
    padding: 44px 0;
    border-top: 1px solid var(--color-border);
    transition: background var(--motion-hover) var(--ease-standard);
  }

  .cases__card:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .cases__card-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 12px;
    flex-wrap: wrap;
    gap: 8px;
  }

  .cases__headline {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-text);
    line-height: 1.3;
  }

  .cases__role {
    color: var(--color-text-dim);
    flex-shrink: 0;
  }

  .cases__result-summary {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-accent);
    margin-bottom: 16px;
    line-height: 1.5;
    max-width: 680px;
  }

  .cases__result-summary::before {
    content: "Result: ";
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
    opacity: 0.7;
    display: block;
    margin-bottom: 4px;
  }

  .cases__body {
    display: grid;
    gap: 12px;
  }

  .cases__situation {
    color: var(--color-text-muted);
  }

  .cases__result {
    color: var(--color-text-dim);
  }

  .cases__metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .cases__metric {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
    color: var(--color-accent);
    background: var(--color-accent-soft);
    padding: 6px 14px;
    border-radius: 2px;
    border: 1px solid var(--color-border-accent);
  }

  .cases__cta {
    text-align: center;
    padding-top: 48px;
  }
</style>
