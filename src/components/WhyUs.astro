---
import { WHY_US, STATS } from '../data/content';
import SectionHeader from './SectionHeader.astro';
---

<section class="why">
  <div class="container">
    <SectionHeader label="Why us">
      Product thinker.<br />Senior builder. Long-term partner.
    </SectionHeader>
    <div class="why__grid">
      {WHY_US.map((item, i) => (
        <div data-fade data-fade-delay={String(i * 0.08)}>
          <h3 class="why__title">{item.title}</h3>
          <p class="text-body why__text">{item.text}</p>
        </div>
      ))}
    </div>
    <div class="why__stats" data-fade data-fade-delay="0.3">
      {STATS.map((s) => (
        <div class="why__stat">
          <div class="why__stat-num">{s.num}</div>
          <div class="why__stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .why {
    padding: 80px 24px 120px;
  }

  .why__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 48px;
  }

  .why__title {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 12px;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .why__text {
    color: var(--color-text-dim);
  }

  .why__stats {
    margin-top: 80px;
    padding: 40px 0;
    border-top: 1px solid var(--color-border-subtle);
    border-bottom: 1px solid var(--color-border-subtle);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 32px;
    text-align: center;
  }

  .why__stat-num {
    font-family: var(--font-mono);
    font-size: 28px;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 4px;
  }

  .why__stat-label {
    font-size: 13px;
    color: var(--color-text-faint);
    letter-spacing: 0.01em;
  }
</style>
