<nav class="nav" id="main-nav">
  <div class="nav__logo">beemflow<span class="nav__dot">.</span></div>
  <a href="#contact" class="btn-primary nav__cta">Book a call</a>
</nav>

<script>
  const nav = document.getElementById('main-nav')!;

  window.addEventListener('scroll', () => {
    const opacity = Math.min(window.scrollY / 200, 1);
    nav.style.setProperty('--nav-bg-opacity', String(opacity));
    nav.classList.toggle('nav--blur', opacity > 0.1);
    nav.classList.toggle('nav--bordered', opacity > 0.3);
  }, { passive: true });
</script>

<style>
  .nav {
    --nav-bg-opacity: 0;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: calc(20px + env(safe-area-inset-top, 0px)) 32px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(248, 245, 240, var(--nav-bg-opacity));
    border-bottom: 1px solid transparent;
    transition: border-color 0.4s ease;
    isolation: isolate;
    transform: translateZ(0);
  }

  @supports (-webkit-touch-callout: none) {
    .nav {
      background: var(--color-bg);
      border-bottom-color: var(--color-border-subtle);
    }

    .nav--blur {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  .nav--blur {
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .nav--bordered {
    border-bottom-color: var(--color-border-subtle);
  }

  .nav__logo {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 15px;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .nav__dot {
    color: var(--color-accent);
  }

  .nav__cta {
    font-size: 11px;
    padding: 10px 24px;
  }
</style>
