---
import FadeIn from './FadeIn.astro';
---

<section class="contact" id="contact" aria-label="Contact">
  <div class="container--narrow">
    <FadeIn>
      <h2 class="contact__heading">Tell us what you're building.</h2>
      <p class="contact__subheading">
        Book a 30-minute call. If there's a fit, we'll map your product
        and show you how fast we can ship it.
      </p>
      <p class="contact__capacity">We take on 2&ndash;3 engagements at a time so every client gets founder-level attention.</p>
    </FadeIn>
    <FadeIn delay={0.1}>
      <div class="contact__embed">
        <div id="cal-embed" role="region" aria-label="Schedule a call"></div>
        <noscript>
          <p class="contact__fallback">
            JavaScript is required for the embedded scheduler. You can still
            <a href="https://cal.com/alecw" target="_blank" rel="noopener noreferrer">book directly on Cal.com</a>.
          </p>
        </noscript>
      </div>
    </FadeIn>
  </div>
</section>

<script>
  (function (C: any, A: string, L: string) {
    let p = function (a: any, ar: any) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal;
      let ar = arguments;
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q || [];
        d.head.appendChild(d.createElement("script")).src = A;
        cal.loaded = true;
      }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1];
        api.q = api.q || [];
        typeof namespace === "string" ? (cal.ns[namespace] = api) && p(api, ar) : p(cal, ar);
        return;
      }
      p(cal, ar);
    };
  })(window, "https://app.cal.com/embed/embed.js", "init");

  (window as any).Cal("init", { origin: "https://cal.com" });
  (window as any).Cal("inline", {
    elementOrSelector: "#cal-embed",
    calLink: "alecw",
    layout: "month_view",
  });
  (window as any).Cal("ui", {
    theme: "dark",
    styles: {
      branding: { brandColor: "#B45309" },
    },
    hideEventTypeDetails: false,
    layout: "month_view",
  });
</script>

<style>
  .contact {
    padding: 140px 32px 80px;
    background: var(--color-bg-invert);
    color: var(--color-text-on-dark);
  }

  .contact__heading {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 400;
    letter-spacing: -0.035em;
    margin-bottom: 16px;
    line-height: 1.15;
    text-align: center;
    color: var(--color-text-on-dark);
  }

  .contact__subheading {
    font-size: 16px;
    color: var(--color-text-muted-on-dark);
    text-align: center;
    margin-bottom: 12px;
    line-height: 1.6;
  }

  .contact__capacity {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.03em;
    color: var(--color-accent);
    text-align: center;
    margin-bottom: 56px;
  }

  .contact__embed {
    min-height: 400px;
    border-radius: 4px;
    overflow: hidden;
  }

  .contact__fallback {
    margin-top: 12px;
    color: var(--color-text-muted-on-dark);
    font-size: 14px;
    text-align: center;
  }

  .contact__fallback a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .contact {
      padding: 100px 20px 60px;
    }
  }
</style>
