---
import FadeIn from './FadeIn.astro';

interface Props {
  label?: string;
  compact?: boolean;
}

const { label, compact } = Astro.props;
---

<FadeIn>
  {label && <p class="label-mono section-label">{label}</p>}
  <h2 class:list={["section-heading", { "section-heading--compact": compact }]}>
    <slot />
  </h2>
</FadeIn>
