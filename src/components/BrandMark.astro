---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={["brand-mark", className]}>
  beemflow<span class="brand-mark__dot">.</span>
</span>

<style>
  .brand-mark {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--fs-body-sm);
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .brand-mark__dot {
    color: var(--color-accent);
  }
</style>
