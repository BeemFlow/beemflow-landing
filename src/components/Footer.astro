---
import BrandMark from './BrandMark.astro';
---

<footer class="footer bg-invert">
  <div class="footer__inner">
    <p class="text-mono-sm footer__brand"><BrandMark /></p>
    <nav class="footer__links" aria-label="Company information">
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <a href="/privacy/">Privacy</a>
    </nav>
    <p class="text-mono-sm footer__text">&copy; 2026 AW Ops LLC</p>
  </div>
</footer>

<style>
  .footer {
    padding: 40px 32px;
    border-top: 1px solid var(--color-border-on-dark);
  }

  .footer__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer__brand {
    color: var(--color-text-muted-on-dark);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .footer__brand :global(.brand-mark) {
    color: var(--color-text-on-dark);
  }

  .footer__text {
    color: var(--color-text-muted-on-dark);
    letter-spacing: 0.02em;
  }

  .footer__links {
    display: flex;
    gap: 20px;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--color-text-muted-on-dark);
  }

  .footer__links a:hover {
    color: var(--color-text-on-dark);
  }

  @media (max-width: 640px) {
    .footer__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
    }
  }
</style>
