---
import BrandMark from './BrandMark.astro';
---

<footer class="footer">
  <div class="footer__inner">
    <p class="text-mono-sm footer__brand"><BrandMark /></p>
    <p class="text-mono-sm footer__text">&copy; 2026 AW Ops LLC</p>
  </div>
</footer>

<style>
  .footer {
    padding: 40px 32px;
    background: var(--color-bg-invert);
    border-top: 1px solid var(--color-border-on-dark);
  }

  .footer__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer__brand {
    color: var(--color-text-muted-on-dark);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .footer__brand :global(.brand-mark) {
    color: var(--color-text-on-dark);
  }

  .footer__text {
    color: var(--color-text-dim-on-dark);
    letter-spacing: 0.02em;
  }
</style>
