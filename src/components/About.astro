---
import { CREDENTIALS } from '../data/content';
import SectionHeader from './SectionHeader.astro';
---

<section class="section about">
  <div class="container--narrow">
    <SectionHeader label="Who we are" compact>
      Alec Wantoch &amp; Zach Pelkey
    </SectionHeader>
    <div data-fade data-fade-delay="0.05">
      <p class="text-mono-sm about__subtitle">Product Engineers &middot; Technical Leaders</p>
    </div>
    <div data-fade data-fade-delay="0.1">
      <p class="text-body-lg about__text">
        We've been building together since college. Co-founded a company that
        got acquired, shipped 20+ products to production, and served as CEO,
        CTO, Head of Product, and senior engineers across fintech, crypto,
        healthcare, and education.
      </p>
    </div>
    <div data-fade data-fade-delay="0.15">
      <p class="text-body-lg about__text">
        Our background is in security engineering: penetration testing, applied
        cryptography, and infrastructure hardening. We've built curriculum
        taught at Columbia, Rice, and 60+ universities, ran a consulting firm
        delivering cryptographic systems for enterprise clients, and most
        recently built the entire product and technical infrastructure for
        Travel Money as sole technical leadership.
      </p>
    </div>
    <div class="about__credentials" data-fade data-fade-delay="0.2">
      {CREDENTIALS.map((cred) =>
        cred.href ? (
          <a class="about__credential about__credential--link" href={cred.href} target="_blank" rel="noopener noreferrer">{cred.label}</a>
        ) : (
          <span class="about__credential">{cred.label}</span>
        )
      )}
    </div>
    <div data-fade data-fade-delay="0.25">
      <p class="text-body-lg about__closer">
        We care about building the right thing, not just building fast. And
        helping founders avoid the expensive mistakes we've already made.
      </p>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--color-bg-subtle);
  }

  .about__subtitle {
    color: var(--color-text-faint);
    margin-bottom: 24px;
    letter-spacing: 0.02em;
  }

  .about__text {
    color: var(--color-text-muted);
    margin-bottom: 20px;
    max-width: 600px;
  }

  .about__credentials {
    margin-top: 16px;
    margin-bottom: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .about__credential {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.03em;
    color: var(--color-text-dim);
    background: var(--color-input-bg);
    padding: 6px 14px;
    border-radius: 4px;
    border: 1px solid var(--color-border);
  }

  .about__credential--link {
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .about__credential--link:hover {
    border-color: var(--color-border-accent);
    color: var(--color-accent);
  }

  .about__closer {
    color: var(--color-text);
    max-width: 600px;
    font-weight: 500;
  }
</style>
