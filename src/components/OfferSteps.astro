---
import FadeIn from './FadeIn.astro';

interface StepLike {
  title: string;
  subtitle?: string;
  price?: string;
  timeline?: string;
  description: string;
  deliverables?: string[];
  bullets?: string[];
  endState?: string | string[];
  callout?: { label: string; text: string };
}

interface Props {
  steps: StepLike[];
}

const { steps } = Astro.props;
---

<div class="step-cards">
  {steps.map((step, i) => {
    const listItems = step.deliverables ?? step.bullets;
    const calloutText = step.callout?.text;
    const calloutLabel = step.callout?.label;

    return (
      <FadeIn delay={i * 0.08}>
        <div class="step-card">
          <div class="step-card__number">{String(i + 1).padStart(2, '0')}</div>
          <div class="step-card__content">
            <div class="step-card__header">
              <h3 class="step-card__title">{step.title}{step.subtitle && <span class="step-card__subtitle"> ({step.subtitle})</span>}</h3>
              <div class="step-card__meta">
                {step.price && <span class="text-mono-sm step-card__price">{step.price}</span>}
                {step.timeline && <span class="text-mono-sm step-card__timeline">{step.timeline}</span>}
              </div>
            </div>

            <p class="text-body step-card__desc" set:html={step.description} />

            {listItems && (
              <ul class="offer-steps__list list-dash">
                {listItems.map((item) => (
                  <li class="text-body" set:html={item} />
                ))}
              </ul>
            )}

            {step.endState && (
              Array.isArray(step.endState) ? (
                <div class="offer-steps__endstate">
                  <span class="offer-steps__endstate-label">End state:</span>
                  <ul class="offer-steps__endstate-list list-dash">
                    {step.endState.map((item) => (
                      <li class="text-body">{item}</li>
                    ))}
                  </ul>
                </div>
              ) : (
                <div class="offer-steps__endstate">
                  <span class="offer-steps__endstate-label">End state:</span>
                  <p class="text-body-sm">{step.endState}</p>
                </div>
              )
            )}

            {calloutText && (
              <p class="step-card__callout" data-label={calloutLabel}>{calloutText}</p>
            )}
          </div>
        </div>
      </FadeIn>
    );
  })}
</div>

<style>
  .offer-steps__list {
    margin: var(--space-sm) 0 0;
  }

  .offer-steps__endstate {
    color: var(--color-text);
    margin-top: var(--space-sm);
    font-size: var(--fs-body-sm);
    font-weight: 500;
  }

  .offer-steps__endstate-label {
    display: block;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .offer-steps__endstate-list {
    margin: 0;
  }
</style>
